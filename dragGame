<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drag & Drop Tic-Tac-Toe</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --accent-x: #38bdf8;
            --accent-o: #f43f5e;
            --border-color: #334155;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        h1 {
            margin-bottom: 5px;
            font-size: 2.2rem;
        }

        #status {
            font-size: 1.2rem;
            margin-bottom: 20px;
            height: 30px;
            font-weight: 500;
        }

        .game-container {
            display: flex;
            gap: 40px;
            align-items: center;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .board {
            display: grid;
            grid-template-columns: repeat(3, 100px);
            grid-template-rows: repeat(3, 100px);
            gap: 10px;
        }

        .cell {
            background-color: #0f172a;
            border: 2px dashed var(--border-color);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: bold;
            transition: background-color 0.2s, border-color 0.2s;
        }

        .cell.drag-over {
            background-color: #334155;
            border-color: var(--text-color);
        }

        .dock {
            display: flex;
            flex-direction: column;
            gap: 20px;
            background: #0f172a;
            padding: 20px;
            border-radius: 12px;
            align-items: center;
            min-width: 90px;
        }

        .dock-title {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #94a3b8;
            margin: 0;
        }

        .draggable-piece {
            width: 70px;
            height: 70px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            cursor: grab;
            user-select: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            transition: transform 0.1s, opacity 0.2s;
        }

        .draggable-piece:active {
            cursor: grabbing;
        }

        .draggable-piece.x {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--accent-x);
            border: 2px solid var(--accent-x);
        }

        .draggable-piece.o {
            background-color: rgba(244, 63, 94, 0.1);
            color: var(--accent-o);
            border: 2px solid var(--accent-o);
        }

        .draggable-piece.disabled {
            opacity: 0.3;
            cursor: not-allowed;
            pointer-events: none;
        }

        #reset-btn {
            margin-top: 25px;
            background-color: #6366f1;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        #reset-btn:hover {
            background-color: #4f46e5;
        }

        .piece-x { color: var(--accent-x); }
        .piece-o { color: var(--accent-o); }
    </style>
</head>
<body>

    <h1>Tic-Tac-Toe</h1>
    <div id="status">Player X's Turn (Drag X to the board)</div>

    <div class="game-container">
        <!-- The Grid -->
        <div class="board" id="board">
            <div class="cell" data-index="0"></div>
            <div class="cell" data-index="1"></div>
            <div class="cell" data-index="2"></div>
            <div class="cell" data-index="3"></div>
            <div class="cell" data-index="4"></div>
            <div class="cell" data-index="5"></div>
            <div class="cell" data-index="6"></div>
            <div class="cell" data-index="7"></div>
            <div class="cell" data-index="8"></div>
        </div>

        <div class="dock">
            <p class="dock-title">Pieces</p>
            <div id="piece-x" class="draggable-piece x" draggable="true">X</div>
            <div id="piece-o" class="draggable-piece o" draggable="true">O</div>
        </div>
    </div>

    <button id="reset-btn" onclick="resetGame()">Restart Game</button>

    <script>
        const boardState = ['', '', '', '', '', '', '', '', ''];
        let currentPlayer = 'X';
        let isGameActive = true;

        const statusDisplay = document.getElementById('status');
        const cells = document.querySelectorAll('.cell');
        const pieceX = document.getElementById('piece-x');
        const pieceO = document.getElementById('piece-o');

        const winningConditions = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8], 
            [0, 3, 6], [1, 4, 7], [2, 5, 8], 
            [0, 4, 8], [2, 4, 6]            
        ];

        function updateDock() {
            if (!isGameActive) {
                pieceX.classList.add('disabled');
                pieceO.classList.add('disabled');
                return;
            }
            if (currentPlayer === 'X') {
                pieceX.classList.remove('disabled');
                pieceO.classList.add('disabled');
            } else {
                pieceO.classList.remove('disabled');
                pieceX.classList.add('disabled');
            }
        }

        [pieceX, pieceO].forEach(piece => {
            piece.addEventListener('dragstart', (e) => {
                if (!isGameActive) return;
                const pieceType = piece.id === 'piece-x' ? 'X' : 'O';
                if (pieceType !== currentPlayer) {
                    e.preventDefault();
                    return;
                }
                e.dataTransfer.setData('text/plain', pieceType);
            });
        });

        cells.forEach(cell => {
            cell.addEventListener('dragover', (e) => {
                e.preventDefault();
                if (isGameActive && cell.textContent === '') {
                    cell.classList.add('drag-over');
                }
            });

            cell.addEventListener('dragleave', () => {
                cell.classList.remove('drag-over');
            });

            cell.addEventListener('drop', (e) => {
                e.preventDefault();
                cell.classList.remove('drag-over');

                if (!isGameActive) return;

                const index = cell.getAttribute('data-index');
                const draggedPlayer = e.dataTransfer.getData('text/plain');

                if (boardState[index] === '' && draggedPlayer === currentPlayer) {
                    boardState[index] = currentPlayer;
                    cell.textContent = currentPlayer;
                    cell.classList.add(currentPlayer === 'X' ? 'piece-x' : 'piece-o');
                    cell.style.border = '2px solid var(--border-color)';

                    handleResultValidation();
                }
            });
        });

        function handleResultValidation() {
            let roundWon = false;
            for (let i = 0; i < winningConditions.length; i++) {
                const [a, b, c] = winningConditions[i];
                if (boardState[a] && boardState[a] === boardState[b] && boardState[a] === boardState[c]) {
                    roundWon = true;
                    break;
                }
            }

            if (roundWon) {
                statusDisplay.innerHTML = `Player <span class="piece-${currentPlayer.toLowerCase()}">${currentPlayer}</span> Has Won! 🎉`;
                isGameActive = false;
                updateDock();
                return;
            }

            let roundDraw = !boardState.includes('');
            if (roundDraw) {
                statusDisplay.textContent = 'Game Ended in a Draw!';
                isGameActive = false;
                updateDock();
                return;
            }

            currentPlayer = currentPlayer === 'X' ? 'O' : 'X';
            statusDisplay.innerHTML = `Player <span class="piece-${currentPlayer.toLowerCase()}">${currentPlayer}</span>'s Turn`;
            updateDock();
        }

        function resetGame() {
            boardState.fill('');
            isGameActive = true;
            currentPlayer = 'X';
            statusDisplay.innerHTML = `Player <span class="piece-x">X</span>'s Turn (Drag X to the board)`;
            
            cells.forEach(cell => {
                cell.textContent = '';
                cell.classList.remove('piece-x', 'piece-o');
                cell.style.border = '2px dashed var(--border-color)';
            });

            updateDock();
        }
        updateDock();
    </script>
</body>
</html>
